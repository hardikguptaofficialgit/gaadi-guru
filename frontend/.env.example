# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser; never put a service-role key here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase (accounts + "My reports"). Leave empty to run without accounts: everything else keeps working.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Set to 1 after enabling the Google provider in Supabase -> Authentication -> Providers.
NEXT_PUBLIC_SUPABASE_GOOGLE=0
